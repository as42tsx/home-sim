{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://as42tsx.github.io/home-sim/schema/plan.v2.schema.json",
  "title": "Home Sim plan v2",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "meta", "floors", "stairs"],
  "properties": {
    "schemaVersion": { "const": 2 },
    "meta": { "$ref": "#/$defs/meta" },
    "floors": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/$defs/floor" }
    },
    "stairs": {
      "type": "array",
      "items": { "$ref": "#/$defs/stair" }
    },
    "markers": { "$ref": "#/$defs/markers" },
    "ext": { "$ref": "#/$defs/ext" }
  },
  "$defs": {
    "ext": {
      "type": "object",
      "additionalProperties": true
    },
    "id": {
      "type": "string",
      "pattern": "^[A-Za-z0-9_-]{1,64}$"
    },
    "meta": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "name", "createdAt", "updatedAt", "unit", "displayUnit", "codeset", "template"],
      "properties": {
        "id": { "$ref": "#/$defs/id" },
        "name": { "type": "string" },
        "createdAt": { "type": "integer" },
        "updatedAt": { "type": "integer" },
        "unit": { "const": "mm" },
        "displayUnit": { "enum": ["metric", "imperial"] },
        "codeset": { "enum": ["cn", "jp", "us"] },
        "template": {
          "anyOf": [
            { "enum": ["apt-1br", "apt-2br", "apt-3br", "jp-ikkodate", "us-villa"] },
            { "type": "null" }
          ]
        }
      }
    },
    "floor": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "name", "elevation", "height", "slab", "ceiling", "nodes", "walls", "openings", "rooms", "furniture", "voids"],
      "properties": {
        "id": { "$ref": "#/$defs/id" },
        "name": { "type": "string" },
        "elevation": { "type": "number" },
        "height": { "type": "number", "exclusiveMinimum": 0 },
        "slab": { "type": "number", "minimum": 0 },
        "ceiling": { "type": "number", "minimum": 0 },
        "nodes": { "type": "array", "items": { "$ref": "#/$defs/node" } },
        "walls": { "type": "array", "items": { "$ref": "#/$defs/wall" } },
        "openings": { "type": "array", "items": { "$ref": "#/$defs/opening" } },
        "rooms": { "type": "array", "items": { "$ref": "#/$defs/room" } },
        "furniture": { "type": "array", "items": { "$ref": "#/$defs/furniture" } },
        "voids": { "type": "array", "items": { "$ref": "#/$defs/void" } },
        "ext": { "$ref": "#/$defs/ext" }
      }
    },
    "node": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "x", "y"],
      "properties": {
        "id": { "$ref": "#/$defs/id" },
        "x": { "type": "number" },
        "y": { "type": "number" },
        "ext": { "$ref": "#/$defs/ext" }
      }
    },
    "finish": {
      "type": "object",
      "additionalProperties": false,
      "required": ["left", "right"],
      "properties": {
        "left": { "type": "string" },
        "right": { "type": "string" }
      }
    },
    "wall": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "a", "b", "thickness", "height", "bearing", "exterior", "demolished", "finish"],
      "properties": {
        "id": { "$ref": "#/$defs/id" },
        "a": { "$ref": "#/$defs/id" },
        "b": { "$ref": "#/$defs/id" },
        "thickness": { "type": "number", "minimum": 60, "maximum": 500 },
        "height": { "anyOf": [{ "type": "number" }, { "type": "null" }] },
        "bearing": { "type": "boolean" },
        "exterior": { "type": "boolean" },
        "demolished": { "type": "boolean" },
        "finish": { "$ref": "#/$defs/finish" },
        "virtual": { "type": "boolean" },
        "ext": { "$ref": "#/$defs/ext" }
      }
    },
    "opening": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "wall", "t", "kind", "width", "height", "sill", "hinge", "swing"],
      "properties": {
        "id": { "$ref": "#/$defs/id" },
        "wall": { "$ref": "#/$defs/id" },
        "t": { "type": "number", "minimum": 0, "maximum": 1 },
        "kind": { "enum": ["door", "window", "slide", "shoji", "fusuma", "garage", "bay"] },
        "width": { "type": "number", "exclusiveMinimum": 0 },
        "height": { "type": "number", "exclusiveMinimum": 0 },
        "sill": { "type": "number", "minimum": 0 },
        "hinge": { "enum": ["left", "right"] },
        "swing": { "enum": ["in", "out"] },
        "ext": { "$ref": "#/$defs/ext" }
      }
    },
    "room": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "name", "type", "floor", "seed"],
      "properties": {
        "id": { "$ref": "#/$defs/id" },
        "name": { "type": "string" },
        "type": {
          "enum": [
            "bedroom", "living", "dining", "ldk", "kitchen", "bath", "toilet", "washroom",
            "balcony", "corridor", "entry", "study", "storage", "closet", "washitsu",
            "garage", "loft", "other"
          ]
        },
        "floor": { "type": "string" },
        "floorOffset": { "type": "number" },
        "seed": {
          "type": "object",
          "additionalProperties": false,
          "required": ["x", "y"],
          "properties": {
            "x": { "type": "number" },
            "y": { "type": "number" }
          }
        },
        "ext": { "$ref": "#/$defs/ext" }
      }
    },
    "furniture": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "type", "name", "cx", "cy", "z", "w", "d", "color"],
      "properties": {
        "id": { "$ref": "#/$defs/id" },
        "type": { "type": "string" },
        "name": { "type": "string" },
        "cx": { "type": "number" },
        "cy": { "type": "number" },
        "z": { "type": "number" },
        "w": { "type": "number", "minimum": 50, "maximum": 6000 },
        "d": { "type": "number", "minimum": 50, "maximum": 6000 },
        "h": { "type": "number" },
        "rot": { "type": "number" },
        "color": { "type": "string", "pattern": "^#[0-9a-fA-F]{6}$" },
        "host": {
          "type": "object",
          "additionalProperties": false,
          "required": ["wall", "side"],
          "properties": {
            "wall": { "$ref": "#/$defs/id" },
            "side": { "enum": ["left", "right"] }
          }
        },
        "ext": { "$ref": "#/$defs/ext" }
      }
    },
    "void": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "poly", "reason"],
      "properties": {
        "id": { "$ref": "#/$defs/id" },
        "poly": {
          "type": "array",
          "minItems": 3,
          "items": {
            "type": "array",
            "minItems": 2,
            "maxItems": 2,
            "items": { "type": "number" }
          }
        },
        "reason": { "enum": ["double-height", "stair", "other"] },
        "ext": { "$ref": "#/$defs/ext" }
      }
    },
    "landing": {
      "type": "object",
      "additionalProperties": false,
      "required": ["at", "size"],
      "properties": {
        "at": { "type": "number", "minimum": 0, "maximum": 1 },
        "size": { "type": "number", "exclusiveMinimum": 0 }
      }
    },
    "stair": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "kind", "from", "to", "x", "y", "rot", "width", "tread", "maxRiser", "handrail", "opening"],
      "properties": {
        "id": { "$ref": "#/$defs/id" },
        "kind": { "enum": ["straight", "L", "U"] },
        "from": { "$ref": "#/$defs/id" },
        "to": { "$ref": "#/$defs/id" },
        "x": { "type": "number" },
        "y": { "type": "number" },
        "rot": { "type": "number" },
        "width": { "type": "number", "exclusiveMinimum": 0 },
        "tread": { "type": "number", "exclusiveMinimum": 0 },
        "maxRiser": { "type": "number", "exclusiveMinimum": 0 },
        "landing": { "$ref": "#/$defs/landing" },
        "handrail": { "enum": ["left", "right", "both"] },
        "opening": { "const": "auto" },
        "turn": { "enum": ["left", "right"] },
        "well": { "type": "number", "minimum": 0 },
        "ext": { "$ref": "#/$defs/ext" }
      },
      "allOf": [
        {
          "if": {
            "properties": { "kind": { "enum": ["L", "U"] } },
            "required": ["kind"]
          },
          "then": {
            "required": ["landing"],
            "properties": {
              "landing": { "$ref": "#/$defs/landing" }
            }
          }
        }
      ]
    },
    "markers": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "walkStart": {
          "type": "object",
          "additionalProperties": false,
          "required": ["floor", "x", "y", "yaw"],
          "properties": {
            "floor": { "$ref": "#/$defs/id" },
            "x": { "type": "number" },
            "y": { "type": "number" },
            "yaw": { "type": "number" }
          }
        }
      }
    }
  }
}
